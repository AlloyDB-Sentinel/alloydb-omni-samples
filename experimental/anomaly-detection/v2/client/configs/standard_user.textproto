# proto-file: v2/client/proto/experiment.proto
# proto-message: experimental.anomaly_detection.v2.client.proto.MarkovExperimentConfig
# Baseline is loaded directly from the upstream standard_user workload.
generator_config_path: "v1/client/markov_standard_user_config.textproto"
training_actions: 30000
training_seed: 42
training_config { max_n: 3 window_length: 300 }
calibration_percentile: 0.99
calibration_actions: 300000
calibration_seed: 43
validation_actions: 30000
validation_seed: 44

# Same actions and timings; sustained activity replaces mostly idle traffic.
anomaly_profiles {
  profile_id: "sustained-activity"

  transitions {
    node_id: "idle"
    edges { destination_id: "idle" weight: 0.05 }
    edges { destination_id: "active_read" weight: 0.95 }
  }
  transitions {
    node_id: "active_read"
    edges { destination_id: "active_read" weight: 0.15 }
    edges { destination_id: "active_write" weight: 0.8 }
    edges { destination_id: "idle" weight: 0.05 }
  }
  transitions {
    node_id: "active_write"
    edges { destination_id: "active_read" weight: 0.15 }
    edges { destination_id: "active_write" weight: 0.8 }
    edges { destination_id: "idle" weight: 0.05 }
  }
}


# Variance-aware scoring: minimum sigma equivalent to one occurrence.
scoring_config { standard_deviation_floor_count: 1 }
injections { segment_id: "segment-1" profile_id: "sustained-activity" start_action: 1500 num_actions: 900 }
injections { segment_id: "segment-2" profile_id: "sustained-activity" start_action: 6200 num_actions: 600 }
injections { segment_id: "segment-3" profile_id: "sustained-activity" start_action: 12450 num_actions: 900 }
injections { segment_id: "segment-4" profile_id: "sustained-activity" start_action: 18150 num_actions: 1200 }
injections { segment_id: "segment-5" profile_id: "sustained-activity" start_action: 24000 num_actions: 450 }
injections { segment_id: "segment-6" profile_id: "sustained-activity" start_action: 28550 num_actions: 300 }
