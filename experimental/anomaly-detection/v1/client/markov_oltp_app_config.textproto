# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Profile: OLTP transactional app.
#
# Behavioral_Intent:
#   - Rate: steady interactive rate, ~5 operations per minute. Node completion
#     times are 8-16 s (mean ~12 s), keeping the app in that interactive range.
#   - Mix: roughly balanced, write-leaning (~45% read / ~55% write). One read
#     template (fetch order) and three write templates (insert order, update
#     inventory, session touch) with balanced edge weights.
#   - Termination: none. A transactional app runs continuously, interleaving
#     reads and writes across orders/products/sessions (no terminal node).
#
# A line-of-business OLTP application: it fetches an order, places new orders,
# decrements product inventory, and keeps the user session fresh. Reads and
# writes interleave through balanced transitions so the steady-state mix lands
# slightly write-heavy at an interactive pace.

markov_sampling {
  nodes {
    id: "fetch_order"
    template {
      normalized_query_template: "SELECT * FROM orders WHERE customer_id = %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 2000000000
        }
      }
    }
    completion_time {
      range {
        min { seconds: 8 }
        max { seconds: 14 }
      }
    }
    edges { destination_id: "insert_order" weight: 0.45 }
    edges { destination_id: "touch_session" weight: 0.3 }
    edges { destination_id: "fetch_order" weight: 0.25 }
  }
  nodes {
    id: "insert_order"
    template {
      normalized_query_template: "INSERT INTO orders (customer_id, status) VALUES (%v, %v)"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 2000000000
        }
      }
      placeholder_values {
        string_placeholder {
          allowed_values: "pending"
          allowed_values: "shipped"
          allowed_values: "delivered"
          allowed_values: "cancelled"
        }
      }
    }
    completion_time {
      range {
        min { seconds: 10 }
        max { seconds: 16 }
      }
    }
    edges { destination_id: "update_inventory" weight: 0.6 }
    edges { destination_id: "fetch_order" weight: 0.4 }
  }
  nodes {
    id: "update_inventory"
    template {
      normalized_query_template: "UPDATE products SET stock = %v WHERE category = %v"
      placeholder_values {
        int_placeholder {
          min: 0
          max: 100000
        }
      }
      placeholder_values {
        string_placeholder {
          allowed_values: "electronics"
          allowed_values: "books"
          allowed_values: "clothing"
          allowed_values: "home"
        }
      }
    }
    completion_time {
      range {
        min { seconds: 10 }
        max { seconds: 16 }
      }
    }
    edges { destination_id: "touch_session" weight: 0.4 }
    edges { destination_id: "fetch_order" weight: 0.5 }
    edges { destination_id: "update_inventory" weight: 0.1 }
  }
  nodes {
    id: "touch_session"
    template {
      normalized_query_template: "UPDATE sessions SET last_seen = %v WHERE session_id = %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 2000000000
        }
      }
      placeholder_values {
        int_placeholder {
          min: 1
          max: 2000000000
        }
      }
    }
    completion_time {
      range {
        min { seconds: 8 }
        max { seconds: 12 }
      }
    }
    edges { destination_id: "fetch_order" weight: 0.7 }
    edges { destination_id: "insert_order" weight: 0.3 }
  }
  start { node_id: "fetch_order" }
}
