# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Profile: Misbehaving / noisy client.
#
# Behavioral_Intent:
#   - Rate: very high, ~60-300 operations per minute. Sub-second completion
#     times (0.1-1 s) drive an erratic, rapid-fire action stream.
#   - Mix: ~80% read / ~20% write. Two read nodes (a hammered SELECT and a
#     rapid retry) dominate; a single churn UPDATE supplies the writes.
#   - Termination: none. The client runs continuously and erratically, with
#     aggressive self-loops keeping it hammering the same statements (no
#     terminal node).
#
# A poorly behaved client that hammers the same read, rapidly retries, and
# occasionally churns a write. The heavy self-loops model tight retry/poll
# regimes, and the sub-second completions keep the action rate high and
# irregular.

markov_sampling {
  nodes {
    id: "hot_select"
    template {
      normalized_query_template: "SELECT * FROM documents WHERE owner_id = %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 100000
        }
      }
    }
    completion_time {
      range {
        min { nanos: 200000000 }
        max { seconds: 1 }
      }
    }
    edges { destination_id: "hot_select" weight: 0.6 }
    edges { destination_id: "retry_select" weight: 0.25 }
    edges { destination_id: "churn_update" weight: 0.15 }
  }
  nodes {
    id: "retry_select"
    template {
      normalized_query_template: "SELECT 1"
    }
    completion_time {
      range {
        min { nanos: 100000000 }
        max { nanos: 500000000 }
      }
    }
    edges { destination_id: "retry_select" weight: 0.5 }
    edges { destination_id: "hot_select" weight: 0.4 }
    edges { destination_id: "churn_update" weight: 0.1 }
  }
  nodes {
    id: "churn_update"
    template {
      normalized_query_template: "UPDATE documents SET body = %v WHERE doc_id = %v"
      placeholder_values {
        string_placeholder {
          allowed_values: "draft"
          allowed_values: "published"
          allowed_values: "archived"
        }
      }
      placeholder_values {
        int_placeholder {
          min: 1
          max: 500000
        }
      }
    }
    completion_time {
      range {
        min { nanos: 300000000 }
        max { seconds: 1 }
      }
    }
    edges { destination_id: "hot_select" weight: 0.5 }
    edges { destination_id: "churn_update" weight: 0.3 }
    edges { destination_id: "retry_select" weight: 0.2 }
  }
  start { node_id: "hot_select" }
}
