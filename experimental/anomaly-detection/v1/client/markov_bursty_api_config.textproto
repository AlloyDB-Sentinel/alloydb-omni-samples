# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Profile: Bursty API backend.
#
# Behavioral_Intent:
#   - Rate: two-regime. A baseline regime idles at ~1-2 operations per minute
#     (completion ranges 30-60 s), and a burst regime fires at ~12-30 operations
#     per minute (completion ranges 2-5 s). The burst action rate is well above
#     5x the baseline rate (burst mean ~3.25 s vs baseline mean ~43.75 s, ~13x).
#   - Mix: read-heavy, ~80% read / ~20% write. Every baseline node and the hot
#     burst read are read-only; the single write template lives in the burst
#     regime.
#   - Termination: none. The two regimes are connected in both directions, so the
#     walk continuously drifts between quiet polling and bursts of API traffic
#     without ever terminating.
#
# An API backend that sits mostly idle issuing low-rate keepalive and status
# polls, then transitions into short, intense bursts of fast session reads and
# writes when client activity arrives. Edges connect baseline -> burst and
# burst -> baseline so the walk oscillates between the two regimes indefinitely.

markov_sampling {
  nodes {
    id: "baseline_poll"
    template {
      normalized_query_template: "SELECT 1"
    }
    completion_time {
      range {
        min { seconds: 40 }
        max { seconds: 60 }
      }
    }
    edges { destination_id: "baseline_poll" weight: 0.5 }    # self-loop: idle keepalive
    edges { destination_id: "baseline_status" weight: 0.25 }
    edges { destination_id: "burst_read" weight: 0.25 }      # baseline -> burst
  }
  nodes {
    id: "baseline_status"
    template {
      normalized_query_template: "SELECT status FROM orders WHERE customer_id = %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 2000000000
        }
      }
    }
    completion_time {
      range {
        min { seconds: 30 }
        max { seconds: 45 }
      }
    }
    edges { destination_id: "baseline_poll" weight: 0.5 }
    edges { destination_id: "burst_read" weight: 0.5 }       # baseline -> burst
  }
  nodes {
    id: "burst_read"
    template {
      normalized_query_template: "SELECT * FROM sessions WHERE session_id = %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 1000000
        }
      }
    }
    completion_time {
      range {
        min { seconds: 2 }
        max { seconds: 4 }
      }
    }
    edges { destination_id: "burst_read" weight: 0.4 }       # self-loop: fast API reads
    edges { destination_id: "burst_write" weight: 0.5 }
    edges { destination_id: "baseline_poll" weight: 0.1 }    # burst -> baseline
  }
  nodes {
    id: "burst_write"
    template {
      normalized_query_template: "UPDATE sessions SET last_seen = %v WHERE session_id = %v"
      placeholder_values {
        int_placeholder {
          min: 1600000000
          max: 1700000000
        }
      }
      placeholder_values {
        int_placeholder {
          min: 1
          max: 1000000
        }
      }
    }
    completion_time {
      range {
        min { seconds: 2 }
        max { seconds: 5 }
      }
    }
    edges { destination_id: "burst_read" weight: 0.6 }
    edges { destination_id: "baseline_poll" weight: 0.4 }    # burst -> baseline
  }
  start { node_id: "baseline_poll" }
}
