# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Profile: Batch ETL / bulk loader.
#
# Behavioral_Intent:
#   - Rate: high-throughput, ~30-60 operations per minute. Every node's
#     completion time is 1-3 s, keeping the loader in that busy range.
#   - Mix: write-dominant, ~70% write / ~30% read by steady-state visitation.
#     Two write templates (bulk INSERT, bulk UPDATE) and two read templates
#     (extract SELECT, validation COUNT) with write-heavy edge weights.
#   - Termination: bounded. The walk drains to a terminal "session_done" node
#     so each walk is a self-contained batch run; the generator restarts a
#     fresh session until --num_logs is reached.
#
# A bulk loader that extracts a batch, fans out into repeated inserts and
# upserts, periodically validates, and finishes the batch. The write-heavy
# self-loops on bulk_insert/bulk_update model sustained load passes.

markov_sampling {
  nodes {
    id: "extract_read"
    template {
      normalized_query_template: "SELECT id, payload FROM events WHERE account_id = %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 2000000000
        }
      }
    }
    completion_time {
      range {
        min { seconds: 1 }
        max { seconds: 2 }
      }
    }
    edges { destination_id: "bulk_insert" weight: 0.6 }
    edges { destination_id: "bulk_update" weight: 0.3 }
    edges { destination_id: "validate_read" weight: 0.1 }
  }
  nodes {
    id: "bulk_insert"
    template {
      normalized_query_template: "INSERT INTO orders (customer_id, status) VALUES (%v, %v)"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 2000000000
        }
      }
      placeholder_values {
        string_placeholder {
          allowed_values: "pending"
          allowed_values: "shipped"
          allowed_values: "delivered"
          allowed_values: "cancelled"
        }
      }
    }
    completion_time {
      range {
        min { seconds: 1 }
        max { seconds: 2 }
      }
    }
    edges { destination_id: "bulk_insert" weight: 0.55 }
    edges { destination_id: "bulk_update" weight: 0.25 }
    edges { destination_id: "validate_read" weight: 0.1 }
    edges { destination_id: "session_done" weight: 0.1 }
  }
  nodes {
    id: "bulk_update"
    template {
      normalized_query_template: "UPDATE products SET stock = %v WHERE category = %v"
      placeholder_values {
        int_placeholder {
          min: 0
          max: 100000
        }
      }
      placeholder_values {
        string_placeholder {
          allowed_values: "electronics"
          allowed_values: "books"
          allowed_values: "clothing"
          allowed_values: "home"
        }
      }
    }
    completion_time {
      range {
        min { seconds: 1 }
        max { seconds: 3 }
      }
    }
    edges { destination_id: "bulk_insert" weight: 0.4 }
    edges { destination_id: "bulk_update" weight: 0.4 }
    edges { destination_id: "validate_read" weight: 0.1 }
    edges { destination_id: "session_done" weight: 0.1 }
  }
  nodes {
    id: "validate_read"
    template {
      normalized_query_template: "SELECT COUNT(*) FROM orders WHERE customer_id = %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 2000000000
        }
      }
    }
    completion_time {
      range {
        min { seconds: 1 }
        max { seconds: 2 }
      }
    }
    edges { destination_id: "bulk_insert" weight: 0.5 }
    edges { destination_id: "session_done" weight: 0.5 }
  }
  nodes {
    id: "session_done"  # terminal: ends the batch session
    template {
      normalized_query_template: "SELECT 1"
    }
    completion_time {
      fixed { seconds: 1 }
    }
  }
  start { node_id: "extract_read" }
}
