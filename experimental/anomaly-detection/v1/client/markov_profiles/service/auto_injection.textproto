# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Automatic anomaly injection: Service usage.
# A service-usage base stream (high-volume point/range reads with rare write
# excursions) with anomalous bursts auto-placed by the generator to a target
# anomalous fraction, rather than hand-listing each injection segment.
#
# For a read-heavy service account, a sudden burst of DDL/maintenance work or
# interactive-user traffic is the anomaly: the bursts run two separate full
# anomaly graphs -- the maintenance-user profile (CREATE INDEX / VACUUM / ALTER)
# and the interactive standard-user profile -- chosen 3:1 by selection weight.
# The generator positions non-overlapping segments deterministically from the
# seeded rng; no segment ranges are hand-specified. Deterministic for a fixed
# seed (R22-R25).

markov_sampling {
  nodes {
    id: "read_point_lookup"
    template {
      normalized_query_template: "SELECT * FROM sessions WHERE session_id = %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 1000000
        }
      }
    }
    completion_time {
      range {
        min { nanos: 15000000 }  # 15 ms
        max { nanos: 25000000 }  # 25 ms -> ~40-66 reads/sec, ~50/sec on average
      }
    }
    # Stay in read traffic the vast majority of the time; rare write excursion.
    edges { destination_id: "read_range_scan" weight: 0.55 }
    edges { destination_id: "read_point_lookup" weight: 0.42 }  # self-loop: sustained reads
    edges { destination_id: "write_update" weight: 0.03 }       # occasional write
  }
  nodes {
    id: "read_range_scan"
    template {
      normalized_query_template: "SELECT id, payload FROM events WHERE account_id = %v AND created_at > %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 50000
        }
      }
      placeholder_values {
        int_placeholder {
          min: 1600000000
          max: 1700000000
        }
      }
    }
    completion_time {
      range {
        min { nanos: 18000000 }  # 18 ms
        max { nanos: 30000000 }  # 30 ms
      }
    }
    edges { destination_id: "read_point_lookup" weight: 0.7 }
    edges { destination_id: "read_range_scan" weight: 0.28 }
    edges { destination_id: "write_update" weight: 0.02 }
  }
  nodes {
    id: "write_update"
    template {
      normalized_query_template: "UPDATE sessions SET last_seen = %v WHERE session_id = %v"
      placeholder_values {
        int_placeholder {
          min: 1600000000
          max: 1700000000
        }
      }
      placeholder_values {
        int_placeholder {
          min: 1
          max: 1000000
        }
      }
    }
    completion_time {
      range {
        min { nanos: 30000000 }  # 30 ms, writes are a bit slower
        max { nanos: 60000000 }  # 60 ms
      }
    }
    # Return to reads after the occasional write.
    edges { destination_id: "read_point_lookup" weight: 1.0 }
  }
  start { node_id: "read_point_lookup" }

  # Automatic anomaly injection: auto-place anomalous bursts over ~8% of the
  # stream, each burst 10-40 actions long, drawn from two separate full anomaly
  # graphs (the maintenance-user and standard-user profiles) chosen 3:1 by
  # selection weight. The generator positions non-overlapping segments
  # deterministically from the seeded rng; no segment ranges are hand-specified.
  auto_injection {
    anomalous_fraction: 0.01
    min_actions: 10
    max_actions: 40
    anomaly_refs {
      anomaly_graph_path: "../../markov_maintenance_user_config.textproto"
      selection_weight: 3
    }
    anomaly_refs {
      anomaly_graph_path: "../../markov_standard_user_config.textproto"
      selection_weight: 1
    }
  }
}
