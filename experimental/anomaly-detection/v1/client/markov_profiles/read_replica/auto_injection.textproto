# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Automatic anomaly injection example for the read-replica reader profile.
# A read-replica base stream (steady point/range/lookup-join reads) with
# anomalous bursts auto-placed by the generator to a target anomalous fraction,
# rather than hand-listing each injection segment. Anomalous bursts run separate
# full anomaly graphs (the bursty-API and OLTP-app sibling profiles) referenced
# by relative path; selection is weighted 2:1. Never references its own base (no
# self-reference) and the referenced graphs carry no injections of their own (no
# chaining).

markov_sampling {
  nodes {
    id: "point_read"
    template {
      normalized_query_template: "SELECT * FROM documents WHERE doc_id = %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 500000
        }
      }
    }
    completion_time {
      range {
        min { seconds: 1 }
        max { seconds: 3 }
      }
    }
    edges { destination_id: "point_read" weight: 0.5 }
    edges { destination_id: "range_read" weight: 0.35 }
    edges { destination_id: "lookup_join_read" weight: 0.15 }
  }
  nodes {
    id: "range_read"
    template {
      normalized_query_template: "SELECT * FROM events WHERE account_id = %v AND created_at > %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 100000
        }
      }
      placeholder_values {
        int_placeholder {
          min: 1
          max: 2000000000
        }
      }
    }
    completion_time {
      range {
        min { seconds: 2 }
        max { seconds: 5 }
      }
    }
    edges { destination_id: "point_read" weight: 0.5 }
    edges { destination_id: "range_read" weight: 0.3 }
    edges { destination_id: "lookup_join_read" weight: 0.2 }
  }
  nodes {
    id: "lookup_join_read"
    template {
      normalized_query_template: "SELECT * FROM orders WHERE customer_id = %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 100000
        }
      }
    }
    completion_time {
      range {
        min { seconds: 2 }
        max { seconds: 4 }
      }
    }
    edges { destination_id: "point_read" weight: 0.6 }
    edges { destination_id: "range_read" weight: 0.4 }
  }
  start { node_id: "point_read" }

  # Automatic anomaly injection: auto-place anomalous bursts over ~5% of the stream,
  # each burst 1-5 actions long, drawn from two separate full anomaly graphs (the
  # bursty-API and OLTP-app sibling profiles) chosen 2:1 by selection weight. The
  # generator positions non-overlapping segments deterministically from the seeded rng;
  # no segment ranges are hand-specified. Neither ref is read-replica's own base.
  auto_injection {
    anomalous_fraction: 0.05
    min_actions: 1
    max_actions: 5
    anomaly_refs {
      anomaly_graph_path: "../../markov_bursty_api_config.textproto"
      selection_weight: 2
    }
    anomaly_refs {
      anomaly_graph_path: "../../markov_oltp_app_config.textproto"
      selection_weight: 1
    }
  }
}
