# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Example individual (read-replica class) demonstrating Edge_Weight_Variance.
#
# Each edge_variances entry carries an asymmetric downward delta `down` and
# upward delta `up` (down != up). For a non-pinned edge whose entry has a
# positive down or up, the individual's weight is sampled uniformly over the
# closed interval [w - down, w + up], where w is the class weight, drawn from
# the single seeded rng, then clamped to be non-negative before renormalization.
# Variance is mutually exclusive with jitter per edge, so no jitter is set here.
#
# Every (source_id, destination_id) below names a real edge of the read-replica
# base graph (point_read, range_read, lookup_join_read). The asymmetric ranges
# bias this individual toward favoring range scans and lingering a little less
# on repeated point reads.

markov_individual {
  base_graph_path: "../../markov_read_replica_config.textproto"

  # point_read -> range_read (class weight 0.35): more headroom upward than
  # downward, so this individual leans toward range scans.
  edge_variances {
    source_id: "point_read"
    destination_id: "range_read"
    down: 0.05
    up: 0.20
  }

  # point_read -> point_read (class weight 0.5): wider downward than upward, so
  # this individual repeats point reads a little less often.
  edge_variances {
    source_id: "point_read"
    destination_id: "point_read"
    down: 0.20
    up: 0.05
  }

  # lookup_join_read -> range_read (class weight 0.4): modest asymmetric spread.
  edge_variances {
    source_id: "lookup_join_read"
    destination_id: "range_read"
    down: 0.05
    up: 0.15
  }
}
