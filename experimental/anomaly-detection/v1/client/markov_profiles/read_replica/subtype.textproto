# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Subtype: Read-replica reader, "range-heavy" variant.
# Layered on the read-replica base graph. A replica client that leans harder on
# range scans: from a point read it is more likely to move into a range read
# than the class baseline, and it repeats point reads less often. Only
# transition weights change; nodes, templates, and completion times are
# inherited from the base graph and the derived graph is renormalized once.
#
# Base edges overridden (all exist in markov_read_replica_config.textproto):
#   point_read -> range_read        0.35 -> 0.55  (skew toward range scans)
#   point_read -> point_read        0.50 -> 0.30  (fewer immediate repeats)
#   point_read -> lookup_join_read  0.15 -> 0.15  (held; kept explicit for clarity)

markov_subtype {
  base_graph_path: "../../markov_read_replica_config.textproto"

  edge_weight_overrides {
    source_id: "point_read"
    destination_id: "range_read"
    weight: 0.55
  }
  edge_weight_overrides {
    source_id: "point_read"
    destination_id: "point_read"
    weight: 0.30
  }
  edge_weight_overrides {
    source_id: "point_read"
    destination_id: "lookup_join_read"
    weight: 0.15
  }
}
