# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Automatic anomaly injection example for the misbehaving / noisy-client profile.
# A noisy-client base stream (high-frequency, erratic hot reads and retries) with
# anomalous bursts auto-placed by the generator to a target anomalous fraction,
# rather than hand-listing each injection segment. Anomalous bursts run separate
# full anomaly graphs (the OLTP-app and analytics sibling profiles) referenced by
# relative path; selection is weighted 1:1. Never references its own base (no
# self-reference) and the referenced graphs carry no injections of their own (no
# chaining).

markov_sampling {
  nodes {
    id: "hot_select"
    template {
      normalized_query_template: "SELECT * FROM documents WHERE owner_id = %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 100000
        }
      }
    }
    completion_time {
      range {
        min { nanos: 200000000 }
        max { seconds: 1 }
      }
    }
    edges { destination_id: "hot_select" weight: 0.6 }
    edges { destination_id: "retry_select" weight: 0.25 }
    edges { destination_id: "churn_update" weight: 0.15 }
  }
  nodes {
    id: "retry_select"
    template {
      normalized_query_template: "SELECT 1"
    }
    completion_time {
      range {
        min { nanos: 100000000 }
        max { nanos: 500000000 }
      }
    }
    edges { destination_id: "retry_select" weight: 0.5 }
    edges { destination_id: "hot_select" weight: 0.4 }
    edges { destination_id: "churn_update" weight: 0.1 }
  }
  nodes {
    id: "churn_update"
    template {
      normalized_query_template: "UPDATE documents SET body = %v WHERE doc_id = %v"
      placeholder_values {
        string_placeholder {
          allowed_values: "draft"
          allowed_values: "published"
          allowed_values: "archived"
        }
      }
      placeholder_values {
        int_placeholder {
          min: 1
          max: 500000
        }
      }
    }
    completion_time {
      range {
        min { nanos: 300000000 }
        max { seconds: 1 }
      }
    }
    edges { destination_id: "hot_select" weight: 0.5 }
    edges { destination_id: "churn_update" weight: 0.3 }
    edges { destination_id: "retry_select" weight: 0.2 }
  }
  start { node_id: "hot_select" }

  # Automatic anomaly injection: auto-place anomalous bursts over ~5% of the stream,
  # each burst 1-5 actions long, drawn from two separate full anomaly graphs (the
  # OLTP-app and analytics sibling profiles) chosen 1:1 by selection weight. The
  # generator positions non-overlapping segments deterministically from the seeded
  # rng; no segment ranges are hand-specified. Neither ref is noisy_client's own base.
  auto_injection {
    anomalous_fraction: 0.05
    min_actions: 1
    max_actions: 5
    anomaly_refs {
      anomaly_graph_path: "../../markov_oltp_app_config.textproto"
      selection_weight: 1
    }
    anomaly_refs {
      anomaly_graph_path: "../../markov_analytics_user_config.textproto"
      selection_weight: 1
    }
  }
}
