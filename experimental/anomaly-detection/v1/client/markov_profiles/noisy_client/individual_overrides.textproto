# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Example individual (noisy_client class) -- "individual A", pinned via
# individual_edge_overrides (Requirement 4.3).
#
# One QueryTemplateConfigs holds exactly one markov_individual, so the two
# noisy_client individuals asked for by R4.3 are shipped as two sibling files:
# this one and individual_overrides_b.textproto. Both derive from the same
# noisy_client base graph but pin different edges to different weights, so the two
# derived individuals end up with differing edge weights.
#
# individual_edge_override is the highest-precedence per-edge mechanism: it pins
# an edge's weight outright (no variance/jitter, no random draw for that edge).
# Every (source_id, destination_id) below names a real edge of the base graph
# (hot_select, retry_select, churn_update). Non-pinned edges keep their class
# weight; a single final renormalization makes each node's outgoing weights sum
# to 1.0.
#
# Individual A hammers the hot read even harder: from hot_select it is much more
# likely to loop back into hot_select than the class baseline.

markov_individual {
  base_graph_path: "../../markov_noisy_client_config.textproto"

  # hot_select: base weights are hot_select=0.6, retry_select=0.25,
  # churn_update=0.15. Pin the hot-read self-loop higher so this individual stays
  # hammering the same SELECT longer than the class.
  individual_edge_overrides {
    source_id: "hot_select"
    destination_id: "hot_select"
    weight: 0.85
  }
}
