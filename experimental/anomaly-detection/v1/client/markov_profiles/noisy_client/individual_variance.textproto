# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Example individual (noisy_client class) demonstrating Edge_Weight_Variance.
#
# Each edge_variances entry carries an asymmetric downward delta `down` and
# upward delta `up` (down != up). For a non-pinned edge whose entry has a
# positive down or up, the individual's weight is sampled uniformly over the
# closed interval [w - down, w + up], where w is the class weight, drawn from
# the single seeded rng, then clamped to be non-negative before renormalization.
# Variance is mutually exclusive with jitter per edge, so no jitter is set here.
#
# Every (source_id, destination_id) below names a real edge of the noisy_client
# base graph (hot_select, retry_select, churn_update). The asymmetric ranges
# bias this individual toward hammering the hot read and churning a touch less.

markov_individual {
  base_graph_path: "../../markov_noisy_client_config.textproto"

  # hot_select -> hot_select (class weight 0.6): more headroom upward than
  # downward, so this individual leans toward a tighter hot-read self-loop.
  edge_variances {
    source_id: "hot_select"
    destination_id: "hot_select"
    down: 0.10
    up: 0.20
  }

  # hot_select -> churn_update (class weight 0.15): wider downward than upward,
  # so this individual churns writes a little less often.
  edge_variances {
    source_id: "hot_select"
    destination_id: "churn_update"
    down: 0.10
    up: 0.03
  }

  # retry_select -> retry_select (class weight 0.5): modest asymmetric spread.
  edge_variances {
    source_id: "retry_select"
    destination_id: "retry_select"
    down: 0.05
    up: 0.15
  }
}
