# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Automatic anomaly injection example for the analytics / reporting profile.
# An analytics base stream (low-frequency aggregate reads) with anomalous bursts
# auto-placed by the generator to a target anomalous fraction, rather than
# hand-listing each injection segment. Anomalous bursts run separate full anomaly
# graphs (the batch-ETL and noisy-client sibling profiles) referenced by relative
# path; selection is weighted 2:1. Never references its own base (no self-reference)
# and the referenced graphs carry no injections of their own (no chaining).

markov_sampling {
  nodes {
    id: "aggregate_scan"
    template {
      normalized_query_template: "SELECT category, COUNT(*) FROM products GROUP BY category"
    }
    completion_time {
      range {
        min { seconds: 30 }
        max { seconds: 45 }
      }
    }
    edges { destination_id: "time_window_report" weight: 0.5 }
    edges { destination_id: "order_rollup" weight: 0.3 }
    edges { destination_id: "aggregate_scan" weight: 0.2 }
  }
  nodes {
    id: "time_window_report"
    template {
      normalized_query_template: "SELECT account_id, SUM(amount) FROM events WHERE created_at > %v GROUP BY account_id"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 2000000000
        }
      }
    }
    completion_time {
      range {
        min { seconds: 35 }
        max { seconds: 60 }
      }
    }
    edges { destination_id: "aggregate_scan" weight: 0.4 }
    edges { destination_id: "order_rollup" weight: 0.4 }
    edges { destination_id: "time_window_report" weight: 0.2 }
  }
  nodes {
    id: "order_rollup"
    template {
      normalized_query_template: "SELECT customer_id, COUNT(*) FROM orders WHERE created_at > %v GROUP BY customer_id"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 2000000000
        }
      }
    }
    completion_time {
      range {
        min { seconds: 30 }
        max { seconds: 50 }
      }
    }
    edges { destination_id: "aggregate_scan" weight: 0.5 }
    edges { destination_id: "time_window_report" weight: 0.3 }
    edges { destination_id: "order_rollup" weight: 0.2 }
  }
  start { node_id: "aggregate_scan" }

  # Automatic anomaly injection: auto-place anomalous bursts over ~1% of the stream,
  # each burst 10-40 actions long. The generator positions non-overlapping segments
  # deterministically from the seeded rng; no segment ranges are hand-specified. Neither
  # ref is analytics' own base.
  auto_injection {
    anomalous_fraction: 0.01
    min_actions: 10
    max_actions: 40
    anomaly_refs {
      anomaly_graph_path: "../../markov_noisy_client_config.textproto"
      selection_weight: 1
    }
    anomaly_refs {
      anomaly_graph_path: "../../markov_read_replica_config.textproto"
      selection_weight: 2
    }
  }
}
