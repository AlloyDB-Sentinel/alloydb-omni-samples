# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Example individual (analytics / reporting class) demonstrating
# Edge_Weight_Variance.
#
# Each edge_variances entry carries an asymmetric downward delta `down` and
# upward delta `up` (down != up). For a non-pinned edge whose entry has a
# positive down or up, the individual's weight is sampled uniformly over the
# closed interval [w - down, w + up], where w is the class weight, drawn from
# the single seeded rng, then clamped to be non-negative before renormalization.
# Variance is mutually exclusive with jitter per edge, so no jitter is set here.
#
# Every (source_id, destination_id) below names a real edge of the analytics
# base graph (aggregate_scan, time_window_report, order_rollup). The asymmetric
# ranges bias this individual toward favoring the windowed report and lingering
# a little less on raw aggregate scans.

markov_individual {
  base_graph_path: "../../markov_analytics_user_config.textproto"

  # aggregate_scan -> time_window_report (class weight 0.5): more headroom
  # upward than downward, so this individual leans toward windowed reporting.
  edge_variances {
    source_id: "aggregate_scan"
    destination_id: "time_window_report"
    down: 0.10
    up: 0.20
  }

  # time_window_report -> order_rollup (class weight 0.4): wider downward than
  # upward, so this individual rolls up orders a little less often.
  edge_variances {
    source_id: "time_window_report"
    destination_id: "order_rollup"
    down: 0.15
    up: 0.05
  }

  # order_rollup -> aggregate_scan (class weight 0.5): modest asymmetric spread.
  edge_variances {
    source_id: "order_rollup"
    destination_id: "aggregate_scan"
    down: 0.05
    up: 0.15
  }
}
