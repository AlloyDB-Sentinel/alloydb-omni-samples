# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Automatic anomaly injection: Maintenance user.
# A maintenance-user base stream (short DDL/vacuum sessions that terminate at
# session_done and restart) with anomalous bursts auto-placed by the generator to
# a target anomalous fraction, rather than hand-listing each injection segment.
#
# For a DBA / maintenance account, a sudden burst of application-style traffic is
# the anomaly: the bursts run two separate full anomaly graphs -- the high-volume
# service-usage profile (sustained point/range reads) and the interactive
# standard-user profile -- chosen 3:1 by selection weight. The generator positions
# non-overlapping segments deterministically from the seeded rng; no segment
# ranges are hand-specified. Deterministic for a fixed seed (R22-R25).

markov_sampling {
  nodes {
    id: "create_index"
    template {
      normalized_query_template: "CREATE INDEX CONCURRENTLY idx_%v ON orders (customer_id)"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 500
        }
      }
    }
    completion_time {
      range {
        min { seconds: 2 }
        max { seconds: 8 }
      }
    }
    edges { destination_id: "alter_table" weight: 0.4 }
    edges { destination_id: "vacuum_analyze" weight: 0.4 }
    edges { destination_id: "session_done" weight: 0.2 }
  }
  nodes {
    id: "alter_table"
    template {
      normalized_query_template: "ALTER TABLE products ADD COLUMN flag_%v BOOLEAN DEFAULT false"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 200
        }
      }
    }
    completion_time {
      range {
        min { seconds: 1 }
        max { seconds: 5 }
      }
    }
    edges { destination_id: "vacuum_analyze" weight: 0.5 }
    edges { destination_id: "create_index" weight: 0.2 }
    edges { destination_id: "session_done" weight: 0.3 }
  }
  nodes {
    id: "vacuum_analyze"
    template {
      normalized_query_template: "VACUUM ANALYZE %v"
      placeholder_values {
        string_placeholder {
          allowed_values: "orders"
          allowed_values: "products"
          allowed_values: "sessions"
          allowed_values: "events"
        }
      }
    }
    completion_time {
      range {
        min { seconds: 3 }
        max { seconds: 20 }
      }
    }
    edges { destination_id: "session_done" weight: 0.7 }
    edges { destination_id: "create_index" weight: 0.3 }
  }
  nodes {
    id: "session_done"  # terminal: ends the maintenance session
    template {
      normalized_query_template: "SELECT 1"
    }
    completion_time {
      fixed { seconds: 1 }
    }
  }
  start { node_id: "create_index" }

  # Automatic anomaly injection: auto-place anomalous bursts over ~10% of the
  # stream, each burst 15-50 actions long, drawn from two separate full anomaly
  # graphs (the service-usage and standard-user profiles) chosen 3:1 by selection
  # weight. The generator positions non-overlapping segments deterministically
  # from the seeded rng; no segment ranges are hand-specified.
  auto_injection {
    anomalous_fraction: 0.01
    min_actions: 15
    max_actions: 50
    anomaly_refs {
      anomaly_graph_path: "../../markov_service_usage_config.textproto"
      selection_weight: 3
    }
    anomaly_refs {
      anomaly_graph_path: "../../markov_standard_user_config.textproto"
      selection_weight: 1
    }
  }
}
