# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Automatic anomaly injection example for the batch ETL / bulk loader profile.
# A batch-ETL base stream (write-dominant bounded batch runs) with anomalous
# bursts auto-placed by the generator to a target anomalous fraction, rather than
# hand-listing each injection segment. Anomalous bursts run separate full anomaly
# graphs (the OLTP-app and analytics sibling profiles) referenced by relative
# path; selection is weighted 1:1. Never references its own base (no
# self-reference) and the referenced graphs carry no injections of their own (no
# chaining).

markov_sampling {
  nodes {
    id: "extract_read"
    template {
      normalized_query_template: "SELECT id, payload FROM events WHERE account_id = %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 2000000000
        }
      }
    }
    completion_time {
      range {
        min { seconds: 1 }
        max { seconds: 2 }
      }
    }
    edges { destination_id: "bulk_insert" weight: 0.6 }
    edges { destination_id: "bulk_update" weight: 0.3 }
    edges { destination_id: "validate_read" weight: 0.1 }
  }
  nodes {
    id: "bulk_insert"
    template {
      normalized_query_template: "INSERT INTO orders (customer_id, status) VALUES (%v, %v)"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 2000000000
        }
      }
      placeholder_values {
        string_placeholder {
          allowed_values: "pending"
          allowed_values: "shipped"
          allowed_values: "delivered"
          allowed_values: "cancelled"
        }
      }
    }
    completion_time {
      range {
        min { seconds: 1 }
        max { seconds: 2 }
      }
    }
    edges { destination_id: "bulk_insert" weight: 0.55 }
    edges { destination_id: "bulk_update" weight: 0.25 }
    edges { destination_id: "validate_read" weight: 0.1 }
    edges { destination_id: "session_done" weight: 0.1 }
  }
  nodes {
    id: "bulk_update"
    template {
      normalized_query_template: "UPDATE products SET stock = %v WHERE category = %v"
      placeholder_values {
        int_placeholder {
          min: 0
          max: 100000
        }
      }
      placeholder_values {
        string_placeholder {
          allowed_values: "electronics"
          allowed_values: "books"
          allowed_values: "clothing"
          allowed_values: "home"
        }
      }
    }
    completion_time {
      range {
        min { seconds: 1 }
        max { seconds: 3 }
      }
    }
    edges { destination_id: "bulk_insert" weight: 0.4 }
    edges { destination_id: "bulk_update" weight: 0.4 }
    edges { destination_id: "validate_read" weight: 0.1 }
    edges { destination_id: "session_done" weight: 0.1 }
  }
  nodes {
    id: "validate_read"
    template {
      normalized_query_template: "SELECT COUNT(*) FROM orders WHERE customer_id = %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 2000000000
        }
      }
    }
    completion_time {
      range {
        min { seconds: 1 }
        max { seconds: 2 }
      }
    }
    edges { destination_id: "bulk_insert" weight: 0.5 }
    edges { destination_id: "session_done" weight: 0.5 }
  }
  nodes {
    id: "session_done"  # terminal: ends the batch session
    template {
      normalized_query_template: "SELECT 1"
    }
    completion_time {
      fixed { seconds: 1 }
    }
  }
  start { node_id: "extract_read" }

  # Automatic anomaly injection: auto-place anomalous bursts over ~1% of the stream,
  # each burst 10-40 actions long. The generator positions non-overlapping segments
  # deterministically from the seeded rng; no segment ranges are hand-specified. Neither
  # ref is analytics' own base.
  auto_injection {
    anomalous_fraction: 0.01
    min_actions: 10
    max_actions: 40
    anomaly_refs {
      anomaly_graph_path: "../../markov_noisy_client_config.textproto"
      selection_weight: 1
    }
    anomaly_refs {
      anomaly_graph_path: "../../markov_read_replica_config.textproto"
      selection_weight: 2
    }
  }
}
