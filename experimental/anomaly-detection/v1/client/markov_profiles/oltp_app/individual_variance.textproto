# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs
#
# Example individual (oltp_app class) demonstrating Edge_Weight_Variance.
#
# Each edge_variances entry carries an asymmetric downward delta `down` and
# upward delta `up` (down != up). For a non-pinned edge whose entry has a
# positive down or up, the individual's weight is sampled uniformly over the
# closed interval [w - down, w + up], where w is the class weight, drawn from
# the single seeded rng, then clamped to be non-negative before renormalization.
# Variance is mutually exclusive with jitter per edge, so no jitter is set here.
#
# Every (source_id, destination_id) below names a real edge of the oltp_app base
# graph (fetch_order, insert_order, update_inventory, touch_session). The
# asymmetric ranges bias this individual toward placing orders and spending a
# little less time re-fetching.

markov_individual {
  base_graph_path: "../../markov_oltp_app_config.textproto"

  # fetch_order -> insert_order (class weight 0.45): more headroom upward than
  # downward, so this individual leans toward placing orders.
  edge_variances {
    source_id: "fetch_order"
    destination_id: "insert_order"
    down: 0.10
    up: 0.20
  }

  # insert_order -> fetch_order (class weight 0.4): wider downward than upward,
  # so this individual re-fetches a little less often after an insert.
  edge_variances {
    source_id: "insert_order"
    destination_id: "fetch_order"
    down: 0.15
    up: 0.05
  }

  # update_inventory -> touch_session (class weight 0.4): modest asymmetric spread.
  edge_variances {
    source_id: "update_inventory"
    destination_id: "touch_session"
    down: 0.05
    up: 0.15
  }
}
