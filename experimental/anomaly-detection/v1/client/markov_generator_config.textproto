# proto-file: experimental/anomaly-detection/v1/generator/proto/query_template_config.proto
# proto-message: QueryTemplateConfigs

markov_sampling {
  nodes {
    id: "login"
    template {
      normalized_query_template: "SELECT id FROM users WHERE email = '%v'"
      placeholder_values {
        string_placeholder {
          allowed_values: "a@x.com"
          allowed_values: "b@x.com"
        }
      }
    }
    completion_time {
      fixed { nanos: 2000000 }  # 2 ms, fixed
    }
    edges { destination_id: "browse" weight: 0.8 }
    edges { destination_id: "checkout" weight: 0.2 }
  }
  nodes {
    id: "browse"
    template {
      normalized_query_template: "SELECT * FROM products WHERE category = %v"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 20
        }
      }
    }
    completion_time {
      range {
        min { nanos: 1000000 }
        max { nanos: 5000000 }
      }  # 1-5 ms
    }
    edges { destination_id: "browse" weight: 0.5 }     # self-loop allowed
    edges { destination_id: "checkout" weight: 0.5 }
  }
  nodes {
    id: "checkout"  # terminal: no edges
    template {
      normalized_query_template: "INSERT INTO orders(user_id, total) VALUES (%v, %v)"
      placeholder_values {
        int_placeholder {
          min: 1
          max: 1000
        }
      }
      placeholder_values {
        int_placeholder {
          min: 10
          max: 500
        }
      }
    }
    completion_time {
      fixed { nanos: 3000000 }  # 3 ms, fixed
    }
  }
  start { node_id: "login" }
}
