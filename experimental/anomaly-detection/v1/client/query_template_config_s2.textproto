        # Friday
        days { hourly_multipliers: [0.12, 0.10, 0.09, 0.09, 0.10, 0.14, 0.28, 0.55, 1.05, 1.50, 1.60, 1.50, 0.90, 1.20, 1.10, 1.00, 0.90, 0.75, 0.60, 0.50, 0.40, 0.32, 0.24, 0.17] }
        # Saturday
